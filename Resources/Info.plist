<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>TrackpadToggle</string>
    <key>CFBundleDisplayName</key>
    <string>Trackpad Toggle</string>
    <key>CFBundleIdentifier</key>
    <string>com.powertools.trackpadtoggle</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>1.1.0</string>
    <key>CFBundleExecutable</key>
    <string>TrackpadToggle</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <!-- Suppress Dock icon — this is a menu-bar-only app -->
    <key>LSUIElement</key>
    <true/>
    <!-- Minimum macOS 14 (Sonoma); adjust down to 13 if needed -->
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <!-- Required for CGEventTap to intercept HID events -->
    <key>NSAccessibilityUsageDescription</key>
    <string>Trackpad Toggle needs Accessibility access to intercept trackpad events system-wide.</string>
    <!-- Required for Input Monitoring so the tap can actually suppress events -->
    <key>NSInputMonitoringUsageDescription</key>
    <string>Trackpad Toggle needs Input Monitoring access to block trackpad events when disabled.</string>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 powertools</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
</dict>
</plist>
